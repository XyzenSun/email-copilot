{
  "name": "email-copilot-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "email-copilot 前端 —— 单用户多邮箱聚合 AI 邮件助手操作台",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../openapi.yaml -o src/api/types.gen.ts",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vueuse/core": "^14.0.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.0.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.3.0"
  }
}
