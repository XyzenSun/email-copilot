# 复制为 .env 并填入真实值；.env 已在 .gitignore 中，不会提交。
#   cp .env.example .env

# 远程 PostgreSQL 连接，JDBC 格式，务必保留 ?sslmode=require
# 例如 Aiven：jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DB_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DB_USERNAME=<数据库用户名>
DB_PASSWORD=<数据库口令>

# 凭据加密主密钥：openssl rand -base64 32
# 首次启动前设置并妥善保存；更换后既有凭据将无法解密
MASTER_KEY=

# 可选
# JAVA_OPTS=-Xmx256m
# APP_VERSION=latest
# APP_PORT=8080